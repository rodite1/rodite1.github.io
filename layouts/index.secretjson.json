{{- $pages := where site.RegularPages "Section" "secret" }}
{{- $index := slice }}
{{- range $pages }}
    {{- $title := .Title }}
    {{- if eq $title "" }}{{ $title = .File.ContentBaseName }}{{ end }}
    {{- $date := "" }}
    {{- if not .Date.IsZero }}{{ $date = .Date | time.Format "2006-01-02" }}{{ end }}
    {{- $index = $index | append (dict "title" $title "date" $date "tags" .Params.tags "categories" .Params.categories "contents" .Plain "permalink" .Permalink) }}
{{- end }}
{{- $index | jsonify }}