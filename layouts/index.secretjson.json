{{- $pages := where site.RegularPages "Section" "secret" }}
{{- $index := slice }}
{{- range $pages }}
    {{- /* 注意：secret 文章的 front matter title 必须是占位符（会公开渲染进 <title>），
           真实标题在这里用文件名，随内容一起加密 */}}
    {{- $title := .File.ContentBaseName }}
    {{- $date := "" }}
    {{- if not .Date.IsZero }}{{ $date = .Date | time.Format "2006-01-02" }}{{ end }}
    {{- $index = $index | append (dict "title" $title "date" $date "tags" .Params.tags "categories" .Params.categories "contents" .Plain "html" .Content "permalink" .Permalink) }}
{{- end }}
{{- $index | jsonify }}